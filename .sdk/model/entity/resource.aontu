# Entity: resource

main: kit: entity: resource: {

  alias: field: {}

  fields: [
    {
      name: "databaseName"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "lastUpdated"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "modeNames"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "one_time"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "rarities"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "success"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "tiered"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "types"
      req: false
      type: "`$OBJECT`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "resource"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/v2/resources/achievements"
          parts: [
            "v2"
            "resources"
            "achievements"
          ]
          select: {
            "$action": "achievement"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.achievements`"
          }
        }
        {
          method: "GET"
          orig: "/v2/resources/challenges"
          parts: [
            "v2"
            "resources"
            "challenges"
          ]
          select: {
            "$action": "challenge"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.challenges`"
          }
        }
        {
          method: "GET"
          orig: "/v2/resources/games"
          parts: [
            "v2"
            "resources"
            "games"
          ]
          select: {
            "$action": "game"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.games`"
          }
        }
        {
          method: "GET"
          orig: "/v2/resources/guilds/achievements"
          parts: [
            "v2"
            "resources"
            "guilds"
            "achievements"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/v2/resources/quests"
          parts: [
            "v2"
            "resources"
            "quests"
          ]
          select: {
            "$action": "quest"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.quests`"
          }
        }
        {
          method: "GET"
          orig: "/v2/resources/vanity/companions"
          parts: [
            "v2"
            "resources"
            "vanity"
            "companions"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/v2/resources/vanity/pets"
          parts: [
            "v2"
            "resources"
            "vanity"
            "pets"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
