# Entity: other

main: kit: entity: other: {

  alias: field: {}

  fields: [
    {
      name: "boosterState"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "boosters"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "staff_rollingDaily"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "staff_total"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "success"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "watchdog_lastMinute"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "watchdog_rollingDaily"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "watchdog_total"
      req: false
      type: "`$INTEGER`"
    }
  ]

  name: "other"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/v2/boosters"
          segments: [
            {
              lit: "v2"
            }
            {
              lit: "boosters"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/v2/counts"
          segments: [
            {
              lit: "v2"
            }
            {
              lit: "counts"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.games`"
          }
        }
        {
          method: "GET"
          orig: "/v2/leaderboards"
          segments: [
            {
              lit: "v2"
            }
            {
              lit: "leaderboards"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.leaderboards`"
          }
        }
        {
          method: "GET"
          orig: "/v2/punishmentstats"
          segments: [
            {
              lit: "v2"
            }
            {
              lit: "punishmentstats"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
